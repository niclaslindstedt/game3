{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sea Haven",
  "mainBinaryName": "seahaven",
  "version": "0.1.0",
  "identifier": "se.agilator.seahaven",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "externalBin": [],
    "category": "Racing Game",
    "shortDescription": "A personal-watercraft racing game on generated northern shores",
    "longDescription": "A personal-watercraft racing game that runs in your browser. Ride a jet ski along generated northern shores through buoy gates and airborne rings, on water built from real wave physics — on your phone or desktop, offline once loaded. No account, no download.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
